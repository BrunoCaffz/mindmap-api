# Modelo do .env.prod da VPS. Copie para .env.prod e preencha. O .env.prod NUNCA vai pro Git.

# Host público da API (o Caddy emite o HTTPS dele). Sem IP próprio de domínio, use sslip.io:
# 203-0-113-10.sslip.io aponta para 203.0.113.10.
API_HOST=203-0-113-10.sslip.io

# Banco
POSTGRES_DB=mindmap
POSTGRES_USER=mindmap
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Login com o Notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Endereço do FRONT na Vercel (o rewrite repassa /api/* para a VPS). Igual ao cadastrado na integração.
NOTION_REDIRECT_URI=https://seu-app.vercel.app/api/auth/notion/callback
APP_FRONTEND_URL=https://seu-app.vercel.app

# AES-256 em base64 (openssl rand -base64 32). Gere uma chave nova só para produção.
TOKEN_ENCRYPTION_KEY=
