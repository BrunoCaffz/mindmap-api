# Modelo das variáveis de ambiente do backend. Aqui não vai nenhum valor real.
#
# O Spring Boot NÃO lê um arquivo .env sozinho: defina estas variáveis no terminal antes de rodar o
# backend (veja "Rodando localmente" no README). O .env de verdade fica fora do Git (.gitignore).

# ---------------------------------------------------------------------------------------------
# Login com o Notion (OAuth2). Crie uma integração PÚBLICA em https://www.notion.so/profile/integrations
# e copie o client id e o client secret dela.
# ---------------------------------------------------------------------------------------------
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# O "Redirect URI" cadastrado na integração precisa ser IGUAL a este valor. O navegador volta para o
# endereço do front, e o rewrite do Next repassa /api/* para o backend.
NOTION_REDIRECT_URI=http://localhost:3000/api/auth/notion/callback

# ---------------------------------------------------------------------------------------------
# Criptografia dos tokens no banco: AES-256, chave de 32 bytes em base64. O app NÃO sobe sem ela.
#   gerar:  openssl rand -base64 32
#   sem openssl:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar a chave deixa ilegíveis os tokens já guardados: todo mundo precisa entrar de novo.
# Nunca reaproveite uma chave de desenvolvimento em produção.
# ---------------------------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------------------------
# Comportamento
# ---------------------------------------------------------------------------------------------
# Para onde o navegador vai depois do login.
APP_FRONTEND_URL=http://localhost:3000

# Cookie de sessão e cookie CSRF com o atributo Secure. false em desenvolvimento (http://localhost),
# TRUE em produção (https). Com true, o navegador não envia os cookies por http.
SESSION_COOKIE_SECURE=false

# Só para desenvolvimento: quem não está logado lê o Notion com o NOTION_TOKEN pessoal abaixo.
# Em produção fica false (o padrão), e o NOTION_TOKEN nem precisa existir.
APP_DEV_TOKEN_FALLBACK=false
NOTION_TOKEN=

# Variável do FRONT (frontend/.env.local), listada aqui só para ficar documentada. Mostra o campo de ID
# sem login, para o fallback acima. Só para desenvolvimento local sem OAuth. NUNCA configure na Vercel
# nem em produção.
NEXT_PUBLIC_DEV_TOKEN_FALLBACK=false
